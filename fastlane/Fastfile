default_platform(:ios)

platform :ios do
  desc "Upload a signed IPA to TestFlight using an App Store Connect API key file"
  lane :upload_testflight do
    key_id = ENV.fetch("ASC_KEY_ID") { UI.user_error!("ASC_KEY_ID is missing") }
    issuer_id = ENV.fetch("ASC_ISSUER_ID") { UI.user_error!("ASC_ISSUER_ID is missing") }
    key_path = ENV.fetch("ASC_KEY_PATH") { UI.user_error!("ASC_KEY_PATH is missing. Decode the .p8 to a temp file first.") }
    ipa = ENV.fetch("IPA_PATH") { UI.user_error!("IPA_PATH is missing. Archive and export the IPA first.") }
    bundle_id = ENV.fetch("IOS_BUNDLE_ID", "com.privateagent.ios")

    UI.user_error!("ASC_KEY_PATH #{key_path} is not a file") unless File.file?(key_path)
    UI.user_error!("IPA_PATH #{ipa} is not a file") unless File.file?(ipa)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      app_identifier: bundle_id,
      skip_waiting_for_build_processing: true,
      changelog: ENV.fetch("TESTFLIGHT_CHANGELOG", "CI build #{ENV.fetch('GITHUB_RUN_NUMBER', 'local')}")
    )
  end
end
