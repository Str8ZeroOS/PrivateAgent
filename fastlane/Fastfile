default_platform(:ios)

platform :ios do
  desc "Upload a signed IPA to TestFlight using an App Store Connect API key"
  lane :upload_testflight do
    key_id = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")
    key_content = ENV.fetch("ASC_KEY_P8_BASE64")
    ipa = ENV.fetch("IPA_PATH")
    bundle_id = ENV.fetch("IOS_BUNDLE_ID", "com.privateagent.ios")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: true,
      in_house: false
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      app_identifier: bundle_id,
      skip_waiting_for_build_processing: true,
      changelog: ENV.fetch("TESTFLIGHT_CHANGELOG", "CI build #{ENV.fetch('GITHUB_RUN_NUMBER', 'local')}")
    )
  end
end
